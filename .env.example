# Environment Variables — AI Dev Team
# Copy this file to .env and fill in real values. NEVER commit .env to git.

# ---- IBM watsonx / Bob API ---------------------------------------------------
# Your IBM watsonx API key (used by the Reflection Agent for LLM calls)
BOB_API_KEY=your_watsonx_api_key_here

# Your watsonx project ID (found in your IBM Cloud project settings)
WATSONX_PROJECT_ID=your_project_id_here

# Inference endpoint — default is us-south, change if your region differs
WATSONX_URL=https://us-south.ml.cloud.ibm.com/ml/v1/text/generation?version=2023-05-29

# Model to use for Reflection Agent rewrites
# ibm/granite-13b-instruct-v2 is the recommended default (good at instruction following)
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# ---- Dashboard ---------------------------------------------------------------
# Path to the run history JSON file written by the pipeline (default is fine)
RUN_HISTORY_PATH=dashboard/run_history.json

# ---- Paths (override defaults if needed) ------------------------------------
AGENT_STATS_PATH=agents/manager_agent/agent_stats.json
PROMPT_HISTORY_DIR=agents/reflection_agent/prompt_history
TASK_SCHEMA_PATH=schemas/task_schema.json
